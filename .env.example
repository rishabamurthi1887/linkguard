# Optional LinkGuard settings. No provider is queried unless configured and the user opts in.
LINKGUARD_DB=./linkguard.db
LINKGUARD_MAX_FILE_BYTES=10485760
LINKGUARD_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
LINKGUARD_RATE_LIMIT_PER_MINUTE=30
# Local HTTP development uses false. Set true behind HTTPS in hosted environments.
LINKGUARD_COOKIE_SECURE=false
LINKGUARD_SESSION_TTL_SECONDS=86400
# Optional URLhaus malware URL lookup; only called after the user opts in per scan.
# Verify current community fair-use/commercial terms before deployment.
URLHAUS_AUTH_KEY=
# Optional Google Web Risk lookup key. Restrict this key to Web Risk in Google Cloud.
WEBRISK_API_KEY=
